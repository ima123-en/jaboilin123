do
	local miscPage = Hub.Pages["Misc"]

	local arV2Conns = {}
	local arV2Scheduled = false

	local function cleanRagV2(char)
		if not char then return end
		local carpetEq = false
		pcall(function()
			local t = char:FindFirstChild("Flying Carpet") or char:FindFirstChild("Rainbow Carpet")
			if t then
				local h = char:FindFirstChild("HumanoidRootPart")
				if h then
					for _, o in ipairs(h:GetChildren()) do
						if o:IsA("BodyVelocity") or o:IsA("BodyPosition") or o:IsA("BodyGyro") then
							carpetEq = true
							break
						end
					end
				end
			end
		end)
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BallSocketConstraint") or d:IsA("NoCollisionConstraint") or d:IsA("HingeConstraint") or (d:IsA("Attachment") and (d.Name == "A" or d.Name == "B")) then
				d:Destroy()
			elseif (d:IsA("BodyVelocity") or d:IsA("BodyPosition") or d:IsA("BodyGyro")) and not carpetEq then
				d:Destroy()
			end
		end
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("Motor6D") then
				d.Enabled = true
			end
		end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			local a = hum:FindFirstChild("Animator")
			if a then
				for _, t in ipairs(a:GetPlayingAnimationTracks()) do
					local n = t.Animation and t.Animation.Name:lower() or ""
					if n:find("rag") or n:find("fall") or n:find("hurt") or n:find("down") then
						t:Stop(0)
					end
				end
			end
		end
		task.defer(function()
			pcall(function()
				local pm = player:FindFirstChild("PlayerScripts")
				if pm then pm = pm:FindFirstChild("PlayerModule") end
				if pm then
					require(pm):GetControls():Enable()
				end
			end)
		end)
	end

	local function cleanRagV2D(char)
		if arV2Scheduled then return end
		arV2Scheduled = true
		task.defer(function()
			arV2Scheduled = false
			if char and char.Parent then
				cleanRagV2(char)
			end
		end)
	end

	local function isRagDesc(o)
		return o:IsA("BallSocketConstraint") or o:IsA("NoCollisionConstraint") or o:IsA("HingeConstraint") or (o:IsA("Attachment") and (o.Name == "A" or o.Name == "B")) or o:IsA("BodyVelocity") or o:IsA("BodyPosition") or o:IsA("BodyGyro")
	end

	local function hookARV2(char)
		for _, c in ipairs(arV2Conns) do
			pcall(function() c:Disconnect() end)
		end
		arV2Conns = {}
		local hum = char:WaitForChild("Humanoid", 10)
		local hrp = char:WaitForChild("HumanoidRootPart", 10)
		if not hum or not hrp then return end
		local lastVel = Vector3.zero
		local isBoosting = false
		table.insert(arV2Conns, hum.StateChanged:Connect(function()
			local st = hum:GetState()
			if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.GettingUp then
				local ca = false
				pcall(function()
					local t = char:FindFirstChild("Flying Carpet") or char:FindFirstChild("Rainbow Carpet")
					if t and hrp then
						for _, o in ipairs(hrp:GetChildren()) do
							if o:IsA("BodyVelocity") or o:IsA("BodyPosition") or o:IsA("BodyGyro") then
								ca = true
							end
						end
					end
				end)
				if not ca then
					hum:ChangeState(Enum.HumanoidStateType.Running)
				end
				cleanRagV2(char)
				pcall(function()
					Workspace.CurrentCamera.CameraSubject = hum
				end)
			end
		end))
		table.insert(arV2Conns, char.DescendantAdded:Connect(function(d)
			if isRagDesc(d) then
				cleanRagV2D(char)
			end
		end))
		table.insert(arV2Conns, RunService.Heartbeat:Connect(function()
			if getgenv().SMKT_DISABLE_VELOCITY then
				lastVel = hrp.AssemblyLinearVelocity
				return
			end
			local st = hum:GetState()
			if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.GettingUp then
				cleanRagV2(char)
				local vel = hrp.AssemblyLinearVelocity
				if (vel - lastVel).Magnitude > 40 and vel.Magnitude > 25 then
					hrp.AssemblyLinearVelocity = vel.Unit * math.min(vel.Magnitude, 15)
				end
				if not isBoosting then
					isBoosting = true
					hum.WalkSpeed = 400
				end
			else
				if isBoosting then
					isBoosting = false
					hum.WalkSpeed = 16
				end
			end
			lastVel = hrp.AssemblyLinearVelocity
		end))
		cleanRagV2(char)
	end

	local function stopARV2()
		arV2Scheduled = false
		for _, c in ipairs(arV2Conns) do
			pcall(function() c:Disconnect() end)
		end
		arV2Conns = {}
	end

	getgenv().CreateToggle(miscPage, "Anti Ragdoll V2", "AntiRagdollV2")
	Hub.Toggles["AntiRagdollV2"].OnToggle = function(state)
		if state then
			stopARV2()
			local ch = player.Character
			if ch then
				task.spawn(function() hookARV2(ch) end)
			end
			table.insert(Hub.Conns, player.CharacterAdded:Connect(function(c)
				task.wait(0.5)
				if Hub.Toggles["AntiRagdollV2"] and Hub.Toggles["AntiRagdollV2"].State then
					task.spawn(function() hookARV2(c) end)
				end
			end))
		else
			stopARV2()
		end
	end

	local carpetSpeedConnection
	local function findAnyTravelTool()
		local ch = player.Character; local bp = player.Backpack; if not bp then return end
		for _, realName in pairs(REAL_TOOL_NAMES) do
			if ch and ch:FindFirstChild(realName) then return ch[realName] end
			if bp:FindFirstChild(realName) then return bp[realName] end
		end
	end
	local function ensureToolEquipped(tool)
		local ch = player.Character; if not ch or not tool then return end
		if tool.Parent ~= ch then local hum = ch:FindFirstChildOfClass("Humanoid"); if hum then hum:EquipTool(tool) end end
	end

	getgenv().CreateToggle(miscPage, "Carpet Speed", "CarpetSpeed")
	Hub.Toggles["CarpetSpeed"].OnToggle = function(state)
		if carpetSpeedConnection then carpetSpeedConnection:Disconnect(); carpetSpeedConnection = nil end
		if state then
			carpetSpeedConnection = RunService.Heartbeat:Connect(function()
				if getgenv().SMKT_DISABLE_VELOCITY then return end
				local ch = player.Character; if not ch then return end
				local hum = ch:FindFirstChildOfClass("Humanoid"); local hrp = ch:FindFirstChild("HumanoidRootPart")
				if not hum or not hrp then return end
				local tool = findAnyTravelTool(); if not tool then return end
				ensureToolEquipped(tool)
				local md = hum.MoveDirection
				if md.Magnitude > 0 then hrp.AssemblyLinearVelocity = Vector3.new(md.X * 140, hrp.AssemblyLinearVelocity.Y, md.Z * 140)
				else hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0) end
			end)
		end
	end

	local abdState = {running = false, conns = {}, origMove = nil, badNames = {Blue = true, DiscoEffect = true, BeeBlur = true, ColorCorrection = true}}
	local abdCamConn
	local abdOrigFOV

	local function abdNuke(obj)
		if obj and obj.Parent and abdState.badNames[obj.Name] then pcall(function() obj:Destroy() end) end
	end

	local function abdBlockBuzz()
		pcall(function()
			local bs = player.PlayerScripts:FindFirstChild("Bee", true)
			if bs then
				local b = bs:FindFirstChild("Buzzing")
				if b and b:IsA("Sound") then
					b:Stop()
					b.Volume = 0
				end
			end
		end)
	end

	local function ToggleAntiBee(enable)
		if enable then
			if abdState.running then return end; abdState.running = true
			for _, i in ipairs(Lighting:GetDescendants()) do abdNuke(i) end
			local c1 = Lighting.DescendantAdded:Connect(function(o) if abdState.running then abdNuke(o) end end)
			table.insert(abdState.conns, c1)
			table.insert(Hub.Conns, c1)
			local c2 = RunService.Heartbeat:Connect(function() if abdState.running then abdBlockBuzz() end end)
			table.insert(abdState.conns, c2)
			table.insert(Hub.Conns, c2)
			pcall(function()
				local pm = player:FindFirstChild("PlayerScripts")
				if pm then pm = pm:FindFirstChild("PlayerModule") end
				if pm then
					local Controls = require(pm):GetControls()
					if Controls then
						abdState.origMove = Controls.moveFunction
						local function pMove(s, mv, rc)
							if abdState.origMove then abdState.origMove(s, mv, rc) end
						end
						local c3 = RunService.Heartbeat:Connect(function()
							if abdState.running and Controls.moveFunction ~= pMove then
								Controls.moveFunction = pMove
							end
						end)
						table.insert(abdState.conns, c3)
						table.insert(Hub.Conns, c3)
						Controls.moveFunction = pMove
					end
				end
			end)
			abdOrigFOV = Workspace.CurrentCamera and Workspace.CurrentCamera.FieldOfView or 70
			abdCamConn = RunService.RenderStepped:Connect(function()
				local cam = Workspace.CurrentCamera
				if cam then cam.FieldOfView = abdOrigFOV end
			end)
			table.insert(abdState.conns, abdCamConn)
			table.insert(Hub.Conns, abdCamConn)
		else
			abdState.running = false
			for _, c in ipairs(abdState.conns) do pcall(function() c:Disconnect() end) end
			abdState.conns = {}
			pcall(function()
				if abdState.origMove then
					local pm = player:FindFirstChild("PlayerScripts")
					if pm then pm = pm:FindFirstChild("PlayerModule") end
					if pm then
						local C = require(pm):GetControls()
						if C then C.moveFunction = abdState.origMove end
					end
				end
			end)
			if abdCamConn then abdCamConn:Disconnect(); abdCamConn = nil end
			abdOrigFOV = nil
		end
	end

	getgenv().CreateToggle(miscPage, "Anti Bee and Disco Effects", "AntiBeeDisco")
	Hub.Toggles["AntiBeeDisco"].OnToggle = function(enable)
		ToggleAntiBee(enable)
	end

	local InfJumpEnabled = false
	getgenv().CreateToggle(miscPage, "Inf Jump", "InfJump")
	Hub.Toggles["InfJump"].OnToggle = function(state) InfJumpEnabled = state end
	RunService.Heartbeat:Connect(function()
		if InfJumpEnabled and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			local c = player.Character; local hrp = c and c:FindFirstChild("HumanoidRootPart")
			if hrp then hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 55, hrp.AssemblyLinearVelocity.Z) end
		end
	end)
end

