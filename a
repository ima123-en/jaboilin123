local function LoadState()
	local ok, data = pcall(function()
		if readfile and isfile and isfile(SAVE_KEY .. ".json") then
			return HttpService:JSONDecode(readfile(SAVE_KEY .. ".json"))
		end
	end)
	if ok and type(data) == "table" then
		if not data.fov then data.fov = 70 end
		if not data.toggles then data.toggles = {} end
		if data.autoOpen == nil then data.autoOpen = true end
		if not data.keybind then data.keybind = "LeftControl" end
		if not data.carpetKeybind then data.carpetKeybind = "G" end
		if not data.guiScale then data.guiScale = 0.8 end
		return data
	end
	return {toggles = {}, keybind = "LeftControl", carpetKeybind = "G", autoOpen = true, fov = 70, guiScale = 0.8}
end

local function SaveState(state)
	pcall(function()
		if writefile then writefile(SAVE_KEY .. ".json", HttpService:JSONEncode(state)) end
	end)
end
