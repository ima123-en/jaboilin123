	local function smktScan()
		local plots = Workspace:FindFirstChild("Plots")
		if not plots then return end
		local newCache = {}
		
		local rd = ReplicatedStorage:FindFirstChild("Packages")
			and ReplicatedStorage.Packages:FindFirstChild("Synchronizer")
			and ReplicatedStorage.Packages.Synchronizer:FindFirstChild("RequestData")
		
		for _, plot in ipairs(plots:GetChildren()) do
			pcall(function()
				if isMyBase2(plot.Name) then return end
				
				local ch = getgenv().getChannel(plot)
				if not ch then return end
				
				local owner = getgenv().sProp(ch, "Owner")
				if not owner then return end
				
				local ownerName = ""
				if typeof(owner) == "Instance" and owner:IsA("Player") then
					ownerName = owner.Name
				elseif type(owner) == "table" and owner.Name then
					ownerName = tostring(owner.Name)
				elseif type(owner) == "string" and owner ~= "" then
					ownerName = owner
				end
				if ownerName == "" then return end
				
				local al = getgenv().sProp(ch, "AnimalList")
				
				if type(al) ~= "table" and rd then
					local ok, data = pcall(function() return rd:InvokeServer(plot.Name) end)
					if ok and type(data) == "table" then
						al = data.AnimalList or data.Animals
					end
				end
				
				if type(al) ~= "table" then return end
				
				for slot, ad in pairs(al) do
					if type(ad) ~= "table" then continue end
					if isInFusingMachine(plot, slot) then continue end
					
					local idx = ad.Index
					local _AD = getgenv().GetAD()
					if not idx or not _AD or not _AD[idx] then continue end
					
					local info = _AD[idx]
					if info.Egg or info.LuckyBlock then continue end
					
					local displayName = info.DisplayName or idx
					local gv = getGenerationVal(idx, ad.Mutation, ad.Traits)
					if gv <= 0 then continue end
					
