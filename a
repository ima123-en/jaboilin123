	local function formatNumber(num)
		if num >= 1e12 then return string.format("%.2fT", num / 1e12)
		elseif num >= 1e9 then return string.format("%.2fB", num / 1e9)
		elseif num >= 1e6 then return string.format("%.2fM", num / 1e6)
		elseif num >= 1e3 then return string.format("%.2fK", num / 1e3)
		else return tostring(math.floor(num)) end
	end

	local function isMyBase2(plotName)
		local plots = Workspace:FindFirstChild("Plots")
		if not plots then return false end
		local plot = plots:FindFirstChild(plotName)
		if not plot then return false end
		local ch = getgenv().getChannel(plot)
		if ch then
			local owner = getgenv().sProp(ch, "Owner")
			if owner then
				if typeof(owner) == "Instance" and owner:IsA("Player") then return owner.UserId == player.UserId end
				if type(owner) == "table" and owner.UserId then return owner.UserId == player.UserId end
				if type(owner) == "string" then
					return owner:lower() == player.Name:lower() or owner:lower() == player.DisplayName:lower()
				end
			end
		end
		local sign = plot:FindFirstChild("PlotSign")
		if sign then
			local gui = sign:FindFirstChildWhichIsA("SurfaceGui", true)
			if gui then
				local lbl = gui:FindFirstChildWhichIsA("TextLabel", true)
				if lbl then
					local t = lbl.Text:lower()
					if t:find(player.Name:lower(), 1, true) or t:find(player.DisplayName:lower(), 1, true) then return true end
				end
			end
			local yb = sign:FindFirstChild("YourBase")
			if yb and yb:IsA("BillboardGui") then return yb.Enabled == true end
		end
		return false
	end

	local function isInFusingMachine(plot, slot)
		local slotNum = tonumber(slot)
		if not slotNum then return false end
		local ch = getgenv().getChannel(plot)
		if not ch then return false end
		local fd = getgenv().sProp(ch, "FusingMachine")
		if fd and type(fd) == "table" then
			if fd.Input1 == slotNum or fd.Input2 == slotNum or fd.Output == slotNum then return true end
			if type(fd.Inputs) == "table" then for _, v in pairs(fd.Inputs) do if v == slotNum then return true end end end
		end
		return false
	end

	local function getGenerationVal(idx, mut, traits)
		local _AS = getgenv().GetAS()
		local _AD = getgenv().GetAD()
		local _MD = getgenv().GetMD()
		local _TD = getgenv().GetTD()
		if not getgenv().loadData() then return 0 end
		if _AS and _AS.GetGeneration then
			local ok, val = pcall(function() return _AS:GetGeneration(idx, mut, traits, nil) end)
			if ok and type(val) == "number" then return val end
		end
		local info = _AD and _AD[idx]
		if not info or not info.Generation then return 0 end
		local mult = 1
		if mut and mut ~= "None" and mut ~= "" and _MD then
			local m = _MD[mut]; if m and m.Modifier then mult += m.Modifier end
		end
		if type(traits) == "table" and _TD then
			for _, tr in ipairs(traits) do
				local t = _TD[tr]; if t and t.MultiplierModifier then mult += t.MultiplierModifier end
			end
		end
		return info.Generation * mult
	end

