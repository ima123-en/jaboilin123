do
	local wallData = {}
	local XRAY_ENABLED = false
	local oldIndex
	oldIndex = hookmetamethod(game, "__index", function(self, key)
		if not checkcaller() and XRAY_ENABLED then
			if key == "LocalTransparencyModifier" or key == "Transparency" then
				if wallData[self] then return 0 end
			end
		end
		return oldIndex(self, key)
	end)
	local function isBaseWall(part)
		if not part:IsA("BasePart") or not part.Anchored then return false end
		local n = part.Name:lower()
		local pn = (part.Parent and part.Parent.Name:lower()) or ""
		return n:find("wall") or n:find("base") or n:find("floor") or n:find("roof") or pn:find("base") or n:find("ceiling") or pn:find("plot")
	end
	local function applyStealthXRay(part, state)
		pcall(function()
			if state then
				if not wallData[part] then wallData[part] = part.LocalTransparencyModifier end
				part.LocalTransparencyModifier = 0.45 + (math.random() * 0.07)
			else
				if wallData[part] then part.LocalTransparencyModifier = wallData[part] end
			end
		end)
	end
	local function refreshXRay()
		local plots = Workspace:FindFirstChild("Plots")
		if not plots then return end
		local allItems = plots:GetDescendants()
		for i, v in ipairs(allItems) do
			if isBaseWall(v) then applyStealthXRay(v, XRAY_ENABLED) end
			if i % 100 == 0 then RunService.Heartbeat:Wait() end
		end
	end
	Workspace:WaitForChild("Plots").DescendantAdded:Connect(function(child)
		if XRAY_ENABLED then
			task.wait(0.5)
			if isBaseWall(child) then applyStealthXRay(child, true) end
		end
	end)
	getgenv().ToggleBaseXRay = function(state)
		XRAY_ENABLED = state
		refreshXRay()
	end
end

